# SculGrok Environment

# === MODE ===
# 0 = paper (default, safe)
# 1 = live (requires --live flag as second lock)
LIVE=0

# === SOLANA ===
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Prefer a private RPC (Helius, Triton, etc.) for production
PUMPPORTAL_API_KEY=
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf

# Hot wallet (encrypted at rest in production)
# Never commit real keys
SOLANA_PRIVATE_KEY_PATH=./secrets/hot-wallet.enc

# === FOREX / MULTI-ASSET (stub) ===
# Fill when you wire a broker
FOREX_BROKER=mt5
FOREX_LOGIN=
FOREX_PASSWORD=
FOREX_SERVER=
FOREX_API_URL=

# === RISK LIMITS (paper & live) ===
MAX_POSITION_PCT=0.08          # max 8% of equity on one idea
MAX_OPEN_POSITIONS=5
DAILY_LOSS_LIMIT_PCT=0.06      # stop the day at -6%
HARD_STOP_PCT=0.35             # -35% from entry
TRAILING_STOP_PCT=0.25
TAKE_PROFIT_X=2.0
TAKE_PROFIT_FRACTION=0.5       # sell half at 2x

# === MICRO $3 PROFILE (paper-first, see docs/MICRO-3USD.md) ===
MICRO_START_EQUITY_USD=3
MICRO_MAX_POSITION_PCT=0.40
MICRO_MAX_OPEN_POSITIONS=2
MICRO_MAX_TRADES_PER_DAY=6
MICRO_DAILY_LOSS_LIMIT_PCT=0.25
MICRO_TP1_X=1.5
MICRO_TP1_FRACTION=0.5
MICRO_TP2_X=2.0
MICRO_TRAILING_PCT=0.18
MICRO_HARD_STOP_PCT=0.30
MICRO_TIME_EXIT_MIN=120
MICRO_JITO_TIP_SOL=0
MICRO_CLOSE_ATA=1

# === ANTI-RUG (Solana) ===
MAX_TOP10_PCT=0.30
MAX_BUNDLE_PCT=0.20
MAX_DEV_SOLD_PCT=0.20
MAX_WASH_PCT=0.50
SETTLE_SECONDS=8

# === AGENT / MODEL ===
# Any OpenAI-compatible endpoint works (xAI, OpenRouter, local, etc.)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
COORDINATOR_MODEL=grok-4
SCOUT_MODEL=grok-4
RISK_MODEL=grok-4

# === OBSERVABILITY ===
LOG_LEVEL=info
OBSIDIAN_VAULT=               # optional path for trade notes
